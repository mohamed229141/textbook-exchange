# Copy to backend/.env  (cp .env.example .env). .env is in .gitignore: NEVER commit it.
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:8080,http://localhost:4566

# ---- Storage: choose ONE ----------------------------------------------------
# (a) nothing set           -> local file backend/data/db.json (quick start)
# (b) DynamoDB on Floci     -> remove the # on the 5 lines below (no secrets: Floci uses test keys)
# STORAGE=dynamodb
# DYNAMODB_TABLE_PREFIX=Tbx
# AWS_PROFILE=floci
# AWS_REGION=us-east-1
# AWS_ENDPOINT_URL=http://localhost:4566
# (c) Neon Postgres         -> paste your connection string (run db/schema.sql once in the Neon SQL editor)
# DATABASE_URL=

# ---- Secrets ------------------------------------------------------------------
# On Floci/AWS the JWT secret comes from Secrets Manager (SECRETS_ID=tbx/app-secrets).
# On your PC either use the Floci secret (uncomment) or generate your own value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# SECRETS_ID=tbx/app-secrets
JWT_SECRET=

# ---- Optional AWS integrations on Floci (from infra/deploy-floci.sh output) ---
# PHOTO_BUCKET=tbx-listing-photos
# S3_FORCE_PATH_STYLE=true
# TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:tbx-request-events
# QUEUE_URL=http://localhost:4566/000000000000/tbx-request-events-queue
# AUDIT_LOG_GROUP=/tbx/audit

# Optional: only university e-mails may register (comma separated)
# ALLOWED_EMAIL_DOMAINS=student.edu,uni.edu
